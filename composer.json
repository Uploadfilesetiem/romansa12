{
    "name": "romansa/kasir-roti-bakar",
    "type": "project",
    "description": "Kasir Roti Bakar Romansa - Laravel, siap deploy ke Laravel Cloud.",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "endroid/qr-code": "^4.8",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
