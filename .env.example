# Contoh. Di Vercel, isi lewat Settings > Environment Variables (bukan file ini).
APP_NAME="Kasir Roti Bakar Romansa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://NAMA-PROJECT.vercel.app
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database online (contoh Neon Postgres)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Fonnte (laporan WhatsApp)
FONNTE_TOKEN=
FONNTE_GROUP_ID=

# Rahasia untuk cron (isi teks acak panjang)
CRON_SECRET=
