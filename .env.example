APP_NAME="Kasir Roti Bakar Romansa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ganti-dengan-domain-kamu.laravel.cloud
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=error

# Lokal (belum deploy): boleh pakai sqlite biar gampang dites tanpa setup.
# Di Laravel Cloud: JANGAN pakai sqlite. Cukup "Attach Database" (Postgres/MySQL)
# di dashboard Laravel Cloud — nilai DB_CONNECTION dkk di bawah ini akan
# otomatis DITIMPA oleh Cloud begitu database di-attach.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=log
