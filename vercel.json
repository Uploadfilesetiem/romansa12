{
  "version": 2,
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.3", "maxDuration": 30 },
    "api/cron.php":  { "runtime": "vercel-php@0.7.3", "maxDuration": 60 }
  },
  "routes": [
    { "src": "/api/cron", "dest": "/api/cron.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 17 * * *" }
  ]
}
